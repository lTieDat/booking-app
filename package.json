{
  "name": "booking-monorepo",
  "version": "0.1.0",
  "description": "Booking application monorepo — user portal and admin portal powered by Turborepo.",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test-unit": "turbo run test-unit",
    "typecheck": "turbo run typecheck",
    "preview": "turbo run preview",
    "generate:dto": "tsx scripts/generate.ts",
    "dev:user": "turbo run dev --filter=user-portal",
    "dev:admin": "turbo run dev --filter=admin-portal",
    "build:user": "turbo run build --filter=user-portal",
    "build:admin": "turbo run build --filter=admin-portal"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "swagger-typescript-api": "^13.12.0",
    "tsx": "^4.22.4",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
